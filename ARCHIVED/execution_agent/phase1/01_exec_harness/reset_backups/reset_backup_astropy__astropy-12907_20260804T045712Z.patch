+def test_nested_cstack_separability():
+    """Nested concatenations retain the child separability matrix."""
+    nested_right = models.Linear1D(1) & (models.Linear1D(2) & models.Linear1D(3))
+    nested_left = (models.Linear1D(1) & models.Linear1D(2)) & models.Linear1D(3)
+    expected = np.eye(3, dtype=bool)
+
+    assert_allclose(separability_matrix(nested_right), expected)
+    assert_allclose(separability_matrix(nested_left), expected)
+
+
+def test_nested_cstack_with_multidimensional_model():
+    cm = models.Linear1D(10) & models.Linear1D(5)
+    model = models.Pix2Sky_TAN() & cm
+    expected = np.array([[True, True, False, False],
+                         [True, True, False, False],
+                         [False, False, True, False],
+                         [False, False, False, True]])
+
+    assert_allclose(separability_matrix(model), expected)
+
