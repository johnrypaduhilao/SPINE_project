+def test_separability_matrix_nested_compound_model():
+    """
+    Regression test for https://github.com/astropy/astropy/issues/XXXX
+    separability_matrix should correctly handle nested CompoundModels,
+    producing a block-diagonal structure when sub-models are independent.
+    """
+    # A nested compound model: Pix2Sky_TAN() & (Linear1D(10) & Linear1D(5))
+    # should produce the same separability matrix as the flat version:
+    # Pix2Sky_TAN() & Linear1D(10) & Linear1D(5)
+    cm = models.Linear1D(10) & models.Linear1D(5)
+    result = separability_matrix(models.Pix2Sky_TAN() & cm)
+    expected = np.array([
+        [True,  True,  False, False],
+        [True,  True,  False, False],
+        [False, False, True,  False],
+        [False, False, False, True],
+    ])
+    assert_allclose(result, expected)
+
+    # A singly-nested compound model: (Linear1D(10) & Linear1D(5)) alone
+    assert_allclose(separability_matrix(cm),
+                    np.array([[True, False], [False, True]]))
+
+    # Doubly-nested: (Linear1D & Linear1D) & (Linear1D & Linear1D)
+    cm2 = cm & cm
+    result2 = separability_matrix(cm2)
+    expected2 = np.eye(4, dtype=bool)
+    assert_allclose(result2, expected2)
+
